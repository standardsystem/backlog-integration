# Standard Node.js/pnpm ignore patterns
node_modules/
dist/
# 「lib/」と書くと apps/mcp-server/src/lib/ のようなソースディレクトリまで無視されるため、
# ビルド出力はルート直下のものだけを対象にする
/lib/
*.tsbuildinfo
.env
.env.local
.env.*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / System
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build artifacts
out/
build/
.next/
.turbo/

# Claude settings
.claude/
# Test build output
dist-test/
