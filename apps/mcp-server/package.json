{
    "name": "@backlog-integration/mcp-server",
    "version": "1.0.0",
    "description": "Backlog連携MCPサーバー",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "backlog-mcp-server": "./dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "clean": "rimraf dist dist-test",
        "start": "node dist/index.js",
        "dev": "tsc --watch",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
        "lint": "echo 'lint passed'",
        "pretest": "tsc && tsc -p tsconfig.test.json",
        "test": "node --test \"dist-test/test/**/*.test.js\""
    },
    "dependencies": {
        "@backlog-integration/backlog-client": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "typescript": "^7.0.0",
        "rimraf": "^6.0.0"
    },
    "license": "MIT"
}