# Backlog API 設定
# BacklogスペースのID（例: your-space.backlog.com の "your-space" 部分）
# "your-space.backlog.jp" や "https://your-space.backlog.com" の形式でも指定できます
BACKLOG_SPACE_ID=your-space

# Backlog API キー（個人設定 > API から発行）
BACKLOG_API_KEY=your-api-key

# 1 を指定すると MCP サーバー起動時の疎通確認（GET /users/myself）を省略する
# BACKLOG_SKIP_STARTUP_CHECK=1

# 実 API に接続するテスト（test/live）で使うプロジェクトキー。
# 未設定の場合、live テストは自動的にスキップされる。
# 【注意】テストは課題・マイルストーン・カテゴリ・課題種別・状態・Wiki を作成して削除するため、
# 本番プロジェクトではなくテスト専用プロジェクトを指定すること（プロジェクト管理者以上の権限が要る）。
# BACKLOG_TEST_PROJECT_KEY=YOUR_TEST_PROJECT
